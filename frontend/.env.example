# API Configuration
VITE_API_BASE_URL=http://localhost:8080

# Preview Mode Configuration (P4.5)
# Set to '1' to enable the Preview Mode UI features (Status Badge, Soft Blocks)
VITE_PREVIEW_MODE=1

# Set to '1' to enable the Frontend-only Simulation when the backend is offline
# This requires VITE_PREVIEW_MODE=1 to be set.
VITE_PREVIEW_SIMULATION=1
